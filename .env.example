# Google Apps Script web app URL (Deploy → Web app → copy URL ending in /exec)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional — must match CONFIG.WEBHOOK_SECRET in scripts/google-apps-script/admission-enquiry.gs
# ENQUIRY_WEBHOOK_SECRET=your-random-secret-here
